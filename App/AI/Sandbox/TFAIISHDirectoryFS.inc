// Revocable, text-only external directory VFS. No host fd/path enters the guest.
// Open content is a bounded snapshot; every read/stat/readdir checks revocation.
static NSString *ExternalRelative(const char *path){NSString *p=[NSString stringWithUTF8String:path];while([p hasPrefix:@"/"])p=[p substringFromIndex:1];return p;}
static NSDictionary *ExternalEntry(struct mount *mount){return (__bridge NSDictionary *)mount->data;}
static NSDictionary *ExternalFD(struct fd *fd){return (__bridge NSDictionary *)fd->data;}
static BOOL ExternalValid(struct fd *fd){NSDictionary *d=ExternalFD(fd);return TFAIReadDirectoryReference(d[@"entry"],@{@"action":@"validate",@"path":d[@"path"]},nil)!=nil;}
static void ExternalStatValue(NSDictionary *row,struct statbuf *st){memset(st,0,sizeof(*st));st->inode=[row[@"inode"] unsignedLongLongValue];st->mode=[row[@"kind"] isEqual:@"directory"]?(S_IFDIR|0555):(S_IFREG|0444);st->size=[row[@"bytes"] longLongValue];st->nlink=1;st->blksize=4096;st->blocks=(st->size+511)/512;}
static ssize_t ExternalRead(struct fd *fd,void *buffer,size_t count){@autoreleasepool{if(!ExternalValid(fd))return _EACCES;NSData *data=ExternalFD(fd)[@"data"];if(!data)return _EISDIR;size_t n=MIN(count,data.length-MIN(data.length,fd->offset));if(n)memcpy(buffer,(const uint8_t *)data.bytes+fd->offset,n);fd->offset+=n;return n;}}
static off_t_ ExternalSeek(struct fd *fd,off_t_ offset,int whence){if(!ExternalValid(fd))return _EACCES;int64_t size=[ExternalFD(fd)[@"data"] length],base=whence==LSEEK_SET?0:whence==LSEEK_CUR?fd->offset:whence==LSEEK_END?size:-1;if(base<0||offset< -base||offset>INT64_MAX-base)return _EINVAL;fd->offset=base+offset;return fd->offset;}
static int ExternalReaddir(struct fd *fd,struct dir_entry *entry){@autoreleasepool{if(!ExternalValid(fd))return _EACCES;NSArray *names=ExternalFD(fd)[@"names"];if(!names)return _ENOTDIR;if(fd->offset>=names.count)return 0;NSString *name=names[fd->offset++];entry->inode=fd->offset;strlcpy(entry->name,name.UTF8String,sizeof(entry->name));return 1;}}
static int ExternalClose(struct fd *fd){if(fd->data){CFRelease(fd->data);fd->data=NULL;}return 0;}
static const struct fd_ops ExternalFDOperations={.read=ExternalRead,.lseek=ExternalSeek,.readdir=ExternalReaddir,.close=ExternalClose};
static struct fd *ExternalOpen(struct mount *mount,const char *path,int flags,int mode){@autoreleasepool{if((flags&O_ACCMODE_)!=O_RDONLY_||(flags&(O_CREAT_|O_TRUNC_|O_APPEND_)))return ERR_PTR(_EROFS);NSString *relative=ExternalRelative(path);NSDictionary *entry=ExternalEntry(mount);NSDictionary *row=TFAIDirectoryGuestSnapshot(entry,relative,YES,nil);if(!row)return ERR_PTR(_EACCES);struct fd *fd=fd_create(&ExternalFDOperations);if(!fd)return ERR_PTR(_ENOMEM);NSMutableDictionary *data=[row mutableCopy];data[@"entry"]=entry;data[@"path"]=relative;fd->data=(void *)CFBridgingRetain(data);ExternalStatValue(row,&fd->stat);return fd;}}
static int ExternalStat(struct mount *mount,const char *path,struct statbuf *st){@autoreleasepool{NSDictionary *row=TFAIDirectoryGuestSnapshot(ExternalEntry(mount),ExternalRelative(path),NO,nil);if(!row)return _EACCES;ExternalStatValue(row,st);return 0;}}
static int ExternalFstat(struct fd *fd,struct statbuf *st){@autoreleasepool{if(!ExternalValid(fd))return _EACCES;*st=fd->stat;return 0;}}
static int ExternalGetpath(struct fd *fd,char *buffer){@autoreleasepool{if(!ExternalValid(fd))return _EACCES;strlcpy(buffer,[@"/" stringByAppendingString:ExternalFD(fd)[@"path"]].UTF8String,MAX_PATH);return 0;}}
static int ExternalMount(struct mount *mount){@autoreleasepool{for(NSDictionary *entry in TFAIDirectoryRegistry.entries)if([entry[@"directoryGrant"] isEqual:[NSString stringWithUTF8String:mount->source]]&&[entry[@"available"] boolValue]){mount->data=(void *)CFBridgingRetain(entry);mount->root_fd=-1;return 0;}return _EACCES;}}
static int ExternalUnmount(struct mount *mount){if(mount->data){CFRelease(mount->data);mount->data=NULL;}return 0;}
static const struct fs_ops ExternalFS={.name="dylix-directory-ro",.mount=ExternalMount,.umount=ExternalUnmount,.open=ExternalOpen,.stat=ExternalStat,.fstat=ExternalFstat,.getpath=ExternalGetpath};
