@interface TFAIProjectWorkspace : UIViewController
@property UIViewController *chat,*editor,*active;
@property UISegmentedControl *switcher;
@property UIView *content;
@property NSLayoutConstraint *contentTopConstraint;
@property BOOL sideBySide;
- (void)showEditor;
@end
// Moving an editor from a navigation stack into a workspace must detach its
// native parent first; a controller cannot belong to both containers.
static void TFDetachWorkspaceEditor(UIViewController *editor){UINavigationController *navigation=editor.navigationController;if(editor.parentViewController==navigation&&navigation){NSMutableArray *stack=[navigation.viewControllers mutableCopy];[stack removeObjectIdenticalTo:editor];[navigation setViewControllers:stack animated:NO];}}
@implementation TFAIProjectWorkspace
- (BOOL)save{return [self.editor respondsToSelector:@selector(save)]?[(id)self.editor save]:YES;}
- (void)viewDidLoad{[super viewDidLoad];self.view.backgroundColor=UIColor.systemBackgroundColor;self.switcher=[[UISegmentedControl alloc]initWithItems:@[@"会话",@"编辑器"]];self.switcher.selectedSegmentIndex=0;[self.switcher addTarget:self action:@selector(changePage) forControlEvents:UIControlEventValueChanged];self.switcher.frame=CGRectMake(0,0,164,32);self.navigationItem.titleView=self.switcher;self.content=[UIView new];self.content.translatesAutoresizingMaskIntoConstraints=NO;[self.view addSubview:self.content];[NSLayoutConstraint activateConstraints:@[(self.contentTopConstraint=[self.content.topAnchor constraintEqualToAnchor:self.view.safeAreaLayoutGuide.topAnchor]),[self.content.leadingAnchor constraintEqualToAnchor:self.view.leadingAnchor],[self.content.trailingAnchor constraintEqualToAnchor:self.view.trailingAnchor],[self.content.bottomAnchor constraintEqualToAnchor:self.view.bottomAnchor]]];[self changePage];}
- (void)viewWillDisappear:(BOOL)animated{[super viewWillDisappear:animated];for(UIViewController *child in (self.sideBySide?@[self.editor,self.chat]:@[self.active]))[child beginAppearanceTransition:NO animated:animated];}
- (BOOL)shouldAutomaticallyForwardAppearanceMethods{return NO;}
- (void)viewWillAppear:(BOOL)animated{[super viewWillAppear:animated];for(UIViewController *child in (self.sideBySide?@[self.editor,self.chat]:@[self.active]))[child beginAppearanceTransition:YES animated:animated];self.navigationItem.rightBarButtonItems=self.active.navigationItem.rightBarButtonItems;[self syncChatAppearance];}
- (void)viewDidAppear:(BOOL)animated{[super viewDidAppear:animated];for(UIViewController *child in (self.sideBySide?@[self.editor,self.chat]:@[self.active]))[child endAppearanceTransition];}
- (void)viewDidDisappear:(BOOL)animated{[super viewDidDisappear:animated];for(UIViewController *child in (self.sideBySide?@[self.editor,self.chat]:@[self.active]))[child endAppearanceTransition];}
- (void)syncChatAppearance{if(@available(iOS 26.0,*)){UINavigationItem *item=self.active.navigationItem;self.navigationItem.standardAppearance=item.standardAppearance;self.navigationItem.scrollEdgeAppearance=item.scrollEdgeAppearance;self.navigationItem.compactAppearance=item.compactAppearance;self.navigationItem.compactScrollEdgeAppearance=item.compactScrollEdgeAppearance;self.contentTopConstraint.active=NO;self.contentTopConstraint=[self.content.topAnchor constraintEqualToAnchor:(self.active==self.chat&&!self.sideBySide)?self.view.topAnchor:self.view.safeAreaLayoutGuide.topAnchor];self.contentTopConstraint.active=YES;}}
- (void)viewDidLayoutSubviews{[super viewDidLayoutSubviews];BOOL wide=self.view.bounds.size.width>=840&&self.traitCollection.horizontalSizeClass==UIUserInterfaceSizeClassRegular;if(wide!=self.sideBySide){self.sideBySide=wide;[self layoutWorkspace];}if(wide){CGFloat width=self.content.bounds.size.width;CGFloat left=floor(width*0.54);self.editor.view.frame=CGRectMake(0,0,left,self.content.bounds.size.height);self.chat.view.frame=CGRectMake(left+1,0,width-left-1,self.content.bounds.size.height);}}
- (void)layoutWorkspace{
 if(self.sideBySide){for(UIViewController *child in @[self.editor,self.chat]){if(!child.parentViewController){[self addChildViewController:child];[child didMoveToParentViewController:self];}if(!child.view.superview){[child beginAppearanceTransition:YES animated:NO];[self.content addSubview:child.view];[child endAppearanceTransition];}child.view.autoresizingMask=UIViewAutoresizingNone;}self.switcher.hidden=NO;self.navigationItem.titleView=self.switcher;self.active=self.switcher.selectedSegmentIndex?self.editor:self.chat;self.navigationItem.rightBarButtonItems=self.active.navigationItem.rightBarButtonItems;[self syncChatAppearance];self.content.backgroundColor=UIColor.separatorColor;
 }else{self.switcher.hidden=NO;self.navigationItem.titleView=self.switcher;UIViewController *next=self.switcher.selectedSegmentIndex?self.editor:self.chat;for(UIViewController *child in @[self.editor,self.chat])if(child!=next&&child.view.superview){[child beginAppearanceTransition:NO animated:NO];[child.view removeFromSuperview];[child endAppearanceTransition];}if(!next.view.superview){[next beginAppearanceTransition:YES animated:NO];[self.content addSubview:next.view];[next endAppearanceTransition];}next.view.frame=self.content.bounds;next.view.autoresizingMask=UIViewAutoresizingFlexibleWidth|UIViewAutoresizingFlexibleHeight;self.active=next;self.navigationItem.rightBarButtonItems=next.navigationItem.rightBarButtonItems;[self syncChatAppearance];} [self.view setNeedsLayout];
}
- (void)showEditor{[self loadViewIfNeeded];self.switcher.selectedSegmentIndex=1;[self changePage];}
- (void)changePage{if(self.sideBySide){[self layoutWorkspace];return;}UIViewController *next=self.switcher.selectedSegmentIndex?self.editor:self.chat;if(next==self.active)return;[self.view endEditing:YES];if(self.active==self.editor&&![self.editor save]){self.switcher.selectedSegmentIndex=1;return;}UIViewController *old=self.active;[old beginAppearanceTransition:NO animated:NO];[old.view removeFromSuperview];[old endAppearanceTransition];if(!next.parentViewController){[self addChildViewController:next];[next didMoveToParentViewController:self];}[next beginAppearanceTransition:YES animated:NO];next.view.frame=self.content.bounds;next.view.autoresizingMask=UIViewAutoresizingFlexibleWidth|UIViewAutoresizingFlexibleHeight;[self.content addSubview:next.view];[next endAppearanceTransition];self.active=next;self.title=@"";self.navigationItem.titleView=self.switcher;self.navigationItem.rightBarButtonItems=next.navigationItem.rightBarButtonItems;self.navigationItem.leftBarButtonItems=nil;self.navigationItem.backButtonTitle=@"AI 会话";[self syncChatAppearance];}
@end

